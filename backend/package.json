    "test:e2e": "jest tests/e2e",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "seed": "node scripts/seed.js",
    "seed:demo": "node scripts/seed-demo.js",
    "audit:security": "node ../security/audit.js",
