// سامانه حواله خودرو — فاز ۱
// دو پنل: نمایندگی‌ها و مدیریت (ادمین)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN // مدیر کل — دسترسی کامل
  SUPPORT // پشتیبانی — فقط تیکت و گزارش تخلف
  FINANCE // مالی — فقط اشتراک و پرداخت‌ها
  AGENT // نماینده و زیرنماینده
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

/// منبع ایجاد اشتراک: توسط ادمین یا توسط نماینده مادر (حالت ماژول)
enum SubscriptionOrigin {
  ADMIN
  PARENT_SEAT
}

/// نوع حواله: عرضه (فروش) یا درخواست خرید
enum HavaleKind {
  OFFER
  REQUEST
}

enum HavaleStatus {
  ACTIVE
  FULFILLED // «فروخته شد» — از لیست عمومی خارج، در پنل مدیریت می‌ماند
  EXPIRED // عمر آگهی تمام شد (برابر «مدت زمان واریز»)
  SUSPENDED
  ARCHIVED
}

/// نوع واگذاری حواله — دو حالت بیشتر ندارد
enum SolhStatus {
  SOLH // صلح
  VEKALATI // وکالتی
}

enum ReportReason {
  FAKE_LISTING
  WRONG_PRICE
  UNREACHABLE
  ALREADY_SOLD
  FRAUD
  OTHER
}

enum ReportStatus {
  PENDING
  CONFIRMED
  REJECTED
  ABUSIVE
}

enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
}

enum SeatOrderStatus {
  PENDING
  PAID
  REJECTED
}

enum SessionEndReason {
  LOGOUT
  KICKED
  EXPIRED
  ADMIN_REVOKED
}

model User {
  id           String     @id @default(cuid())
  username     String     @unique
  passwordHash String
  phone        String     @unique
  fullName     String
  role         Role       @default(AGENT)
  status       UserStatus @default(ACTIVE)

  // ---- پروفایل نمایندگی ----
  // برای هر نماینده الزامی است. کد زیرنماینده خودکار از کد مادر ساخته می‌شود.
  // این فیلدها «قفل‌شده»‌اند: تغییرشان فقط با تیکت و تأیید ادمین ممکن است و
  // با تغییر، همه‌ی آگهی‌های همان نماینده به‌روز می‌شوند.
  agencyCode       String? @unique
  agencyName       String?
  city             String?
  coordinatorName  String?
  coordinatorPhone String?

  // ---- امنیت ----
  mustChangePassword Boolean @default(true) // اولین ورود: تغییر اجباری پسورد

  // ---- سقف نمایش مشخصات ----
  // اگر پر باشند، سقف پلن را برای همین حساب بازنویسی می‌کنند
  dailyRevealLimitOverride   Int?
  monthlyRevealLimitOverride Int?

  // ---- حالت ماژول / زیرنمایندگی ----
  // حساب هرگز حذف نمی‌شود؛ فقط status به SUSPENDED می‌رود.
  // کد نمایندگی زیرنماینده خودکار از کد مادر ساخته می‌شود: G-1024-07
  isReseller  Boolean @default(false)
  // سقف زیرنماینده‌های مجاز. صورتحساب ماهانه‌ی مادر بر اساس تعداد
  // زیرنماینده‌ی فعال محاسبه می‌شود، نه این عدد.
  seatCredits Int     @default(0)
  parentId    String?
  parent      User?   @relation("AgentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    User[]  @relation("AgentHierarchy")

  // ---- سلامت رفتاری ----
  // زمان تعلیق. برای محاسبه‌ی ظرفیت لازم است: تعلیق وسط دوره ظرفیت را آزاد
  // نمی‌کند (بند ۴.۸)، پس باید بدانیم تعلیق در کدام دوره اتفاق افتاده.
  suspendedAt DateTime?

  fakeStrikes        Int     @default(0)
  falseReportStrikes Int     @default(0)
  adminNote          String?

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  subscriptions       Subscription[]    @relation("SubscriptionOwner")
  grantedSubscription Subscription[]    @relation("SubscriptionCreator")
  havales             Havale[]
  sessions            AuthSession[]
  otpChallenges       OtpChallenge[]
  reveals             ContactReveal[]
  reportsFiled        ViolationReport[] @relation("ReportReporter")
  reportsReviewed     ViolationReport[] @relation("ReportReviewer")
  tickets             Ticket[]
  ticketMessages      TicketMessage[]
  seatOrders          SeatOrder[]       @relation("SeatOrderBuyer")
  seatOrdersReviewed  SeatOrder[]       @relation("SeatOrderReviewer")
  activityLogs        ActivityLog[]
  smsMessages         SmsMessage[]

  @@index([role, status])
  @@index([parentId])
}

model Plan {
  id                 String  @id @default(cuid())
  name               String  @unique
  durationDays       Int
  priceToman         BigInt
  dailyRevealLimit   Int     @default(30)
  monthlyRevealLimit Int     @default(300)
  maxActiveHavale    Int     @default(0) // ۰ یعنی بدون سقف
  isActive           Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("SubscriptionOwner", fields: [userId], references: [id], onDelete: Cascade)

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  startsAt   DateTime           @default(now())
  // برای اشتراک‌های PARENT_SEAT این تاریخ مرجع نیست؛ انقضای مؤثر همیشه
  // از اشتراک فعال نماینده‌ی مادر خوانده می‌شود تا تمدید مادر آنی اعمال شود.
  expiresAt  DateTime
  status     SubscriptionStatus @default(ACTIVE)
  priceToman BigInt             @default(0)
  origin     SubscriptionOrigin @default(ADMIN)

  createdById String?
  createdBy   User?   @relation("SubscriptionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status, expiresAt])
}

model Havale {
  id     String     @id @default(cuid())
  serial Int        @unique @default(autoincrement())
  kind   HavaleKind

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // الزامی در هر دو نوع.
  // carModelId مرجع کاتالوگ است و فیلتر روی آن انجام می‌شود؛ carType اسنپ‌شات
  // نام همان لحظه است تا تغییر نام مدل، حواله‌های قدیمی را بازنویسی نکند.
  carModelId String?
  carModel   CarModel?  @relation(fields: [carModelId], references: [id], onDelete: SetNull)
  carType    String
  solh       SolhStatus

  // در «حواله فروش» الزامی، در «درخواست خرید» اختیاری
  carColor        String?
  model           String?
  amountToman     BigInt? // مبلغ حواله
  paidAmountToman BigInt? // مبلغ واریزی تا امروز به شرکت خودروساز
  deliveryDays    Int? // زمان تحویل، به روز
  depositDays     Int? // مدت زمان واریز: مهلت خریدار، به روز
  supplierCompany String?

  // اطلاعات تماس روی حواله ذخیره نمی‌شود؛ همیشه از پروفایل مالک خوانده می‌شود
  // تا با تغییر پروفایل، همه‌ی آگهی‌ها یکجا به‌روز شوند.

  description String?
  status      HavaleStatus @default(ACTIVE)

  suspendReason String?
  // حذف نرم: از دید نماینده‌ها ناپدید می‌شود ولی سابقه‌ی بازدید و
  // گزارش‌های تخلف مربوط به آن در پنل مدیریت باقی می‌ماند.
  deletedAt     DateTime?

  // شمارنده‌ی بازدید — صاحب آگهی فقط همین عدد را می‌بیند، نه هویت بازدیدکننده‌ها
  revealCount Int @default(0)
  reportCount Int @default(0)

  // عمر آگهی: در حواله فروش برابر «مدت زمان واریز»، در درخواست خرید ۷ روز.
  // قابل تمدید یک‌کلیکی.
  closesAt   DateTime?
  renewedAt  DateTime?
  renewCount Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reveals ContactReveal[]
  reports ViolationReport[]

  @@index([status, closesAt])
  @@index([deletedAt])
  @@index([kind, status, createdAt])
  @@index([ownerId, kind, status])
  @@index([carModelId, status])
  @@index([carType, carColor])
  @@index([supplierCompany])
}

/// هر بار که یک نماینده «مشخصات فروشنده» یک حواله را باز می‌کند اینجا ثبت می‌شود
model ContactReveal {
  id String @id @default(cuid())

  havaleId String
  havale   Havale @relation(fields: [havaleId], references: [id], onDelete: Cascade)

  viewerId String
  viewer   User   @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  ip              String?
  // شماره و کدی که *همان لحظه* نشان داده شد. چون اطلاعات تماس با تأیید
  // ادمین قابل تغییر است، بدون این دو فیلد مدرکی از آنچه واقعاً دیده شده نمی‌ماند.
  phoneShown      String?
  agencyCodeShown String?
  createdAt       DateTime @default(now())

  @@unique([havaleId, viewerId])
  @@index([viewerId, createdAt])
  @@index([havaleId, createdAt])
}

model ViolationReport {
  id     String @id @default(cuid())
  serial Int    @unique @default(autoincrement())

  havaleId String
  havale   Havale @relation(fields: [havaleId], references: [id], onDelete: Cascade)

  reporterId String
  reporter   User   @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  // گزارش تا ۳۰ روز پس از بسته شدن آگهی هم پذیرفته می‌شود
  reason      ReportReason
  description String
  status      ReportStatus @default(PENDING)

  adminNote          String?
  // زمان اطلاع‌رسانی به آگهی‌دهنده پس از تأیید تخلف، تا فرصت پاسخ از راه تیکت داشته باشد
  ownerNotifiedAt    DateTime?
  // اخطار سوم حساب را تعلیق می‌کند و پشتیبانی حق تعلیق ندارد؛ پس در صف تأیید
  // مدیر کل می‌نشیند (بازبینی سوم، اصلاح ۴).
  needsSuperApproval Boolean   @default(false)

  reviewedById String?
  reviewedBy   User?     @relation("ReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?

  createdAt DateTime @default(now())

  @@unique([havaleId, reporterId])
  @@index([status, createdAt])
  @@index([needsSuperApproval, createdAt])
  @@index([reporterId, createdAt])
}

model Ticket {
  id     String @id @default(cuid())
  serial Int    @unique @default(autoincrement())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subject  String
  priority TicketPriority @default(NORMAL)
  status   TicketStatus   @default(OPEN)

  lastReplyAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages TicketMessage[]

  @@index([status, lastReplyAt])
  @@index([userId, createdAt])
}

model TicketMessage {
  id String @id @default(cuid())

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  body      String
  isStaff   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

/// نشست فعال — هر حساب فقط یک نشست زنده دارد
model AuthSession {
  id        String @id @default(cuid())
  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  ip        String?
  userAgent String?

  createdAt  DateTime          @default(now())
  lastSeenAt DateTime          @default(now())
  expiresAt  DateTime
  endedAt    DateTime?
  endReason  SessionEndReason?

  @@index([userId, endedAt])
}

/// کد دو عاملی پیامکی
model OtpChallenge {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
}

/// درخواست خرید ظرفیت زیرنمایندگی (حالت ماژول)
model SeatOrder {
  id     String @id @default(cuid())
  serial Int    @unique @default(autoincrement())

  buyerId String
  buyer   User   @relation("SeatOrderBuyer", fields: [buyerId], references: [id], onDelete: Cascade)

  seats          Int
  unitPriceToman BigInt
  totalToman     BigInt
  status         SeatOrderStatus @default(PENDING)

  buyerNote       String?
  adminNote       String?
  // زمان اطلاع‌رسانی به آگهی‌دهنده پس از تأیید تخلف، تا فرصت پاسخ از راه تیکت داشته باشد
  ownerNotifiedAt DateTime?
  reviewedById    String?
  reviewedBy      User?     @relation("SeatOrderReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([buyerId, createdAt])
}

/// گزارش فعالیت برای مانیتورینگ در پنل مدیریت
model ActivityLog {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action     String
  targetType String?
  targetId   String?
  summary    String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

/// تنظیمات قابل ویرایش سامانه (قیمت ظرفیت، سقف گزارش‌ها و ...)
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// کاتالوگ خودرو
//
// شرکت عرضه‌کننده، برند و مدل به‌صورت جدول نگه داشته می‌شوند تا از پنل مدیریت
// قابل ویرایش باشند و «فیلتر بر اساس مدل» دقیق کار کند. متن آزاد این را نمی‌دهد:
// «فونیکس FX» و «فونیکس اف ایکس» دو چیز متفاوت می‌شوند و هیچ‌کدام همدیگر را
// پیدا نمی‌کنند.
//
// نام برند و مدل روی خود حواله هم ذخیره می‌شود (اسنپ‌شات)، چون اگر بعداً اسم یک
// مدل عوض شود، حواله‌های قدیمی باید همان چیزی را نشان دهند که موقع ثبت بوده‌اند.
// ─────────────────────────────────────────────────────────────────────────────

/// شرکت خودروساز / واردکننده — مثل «مدیران خودرو»
model CarCompany {
  id        String  @id @default(cuid())
  name      String  @unique
  slug      String  @unique
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brands CarBrand[]

  @@index([isActive, sortOrder])
}

/// برند زیرمجموعه — مثل ام‌وی‌ام، فونیکس، اکستریم
model CarBrand {
  id        String     @id @default(cuid())
  companyId String
  company   CarCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name      String
  slug      String  @unique
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  models CarModel[]

  @@unique([companyId, name])
  @@index([isActive, sortOrder])
}

/// مدل خودرو — مثل «فونیکس FX پریمیوم»
model CarModel {
  id      String   @id @default(cuid())
  brandId String
  brand   CarBrand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  // بدون slug: مدل‌ها با شناسه ارجاع داده می‌شوند و اسم فارسی‌شان چیزی برای
  // ساختن slug یکتا نمی‌دهد — «فونیکس FX» و «فونیکس FX پریمیوم» هر دو fx می‌شدند.
  name      String
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  havales Havale[]

  @@unique([brandId, name])
  @@index([isActive, sortOrder])
}

/// رنگ استاندارد. لیست بسته باعث می‌شود فیلتر رنگ واقعاً کار کند.
model CarColor {
  id        String  @id @default(cuid())
  name      String  @unique
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// ─────────────────────────────────────────────────────────────────────────────
// پیامک
//
// تا وقتی پنل پیامک خریداری نشود، سامانه با کلید خاموش کار می‌کند: پیام‌ها ساخته
// و ذخیره می‌شوند ولی ارسال نمی‌شوند. این‌طور در دمو معلوم است دقیقاً چه چیزی
// قرار بوده برای چه کسی برود، و روزی که پنل فعال شد فقط کلید عوض می‌شود.
// ─────────────────────────────────────────────────────────────────────────────

enum SmsStatus {
  PENDING
  SENT
  FAILED
  SKIPPED // پنل خاموش بوده؛ پیام ساخته شد ولی ارسال نشد
}

model SmsMessage {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  to       String
  template String
  // متن نهایی همان لحظه ذخیره می‌شود؛ اگر بعداً قالب عوض شود، سابقه دست‌نخورده می‌ماند.
  body     String

  status     SmsStatus @default(PENDING)
  driver     String
  providerId String?
  error      String?

  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([status, createdAt])
  @@index([to, createdAt])
  @@index([userId, createdAt])
}
