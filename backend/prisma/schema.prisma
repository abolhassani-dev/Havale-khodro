// سامانه حواله خودرو — فاز ۱
// دو پنل: نمایندگی‌ها و مدیریت (ادمین)

generator client {
  provider      = "prisma-client-js"
  // The engine is a compiled binary that links against OpenSSL, so the build it
  // needs depends on the operating system it will run on. Stated explicitly
  // because leaving it to detection is what failed on the first deploy: the
  // engine could not identify the platform and returned a plain-text error
  // where Prisma expected JSON, which hid the real cause completely.
  //
  // `native` covers a developer's own machine; `debian-openssl-3.0.x` is the
  // container (node:20-slim, Debian bookworm).
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  /// مالک سامانه. تنها نقشی که همه‌چیز را می‌بیند و می‌تواند نقش بسازد.
  /// از دید هر نقش دیگری وجود ندارد — نه در فهرست‌ها، نه در آمار، نه در لاگ.
  OWNER
  /// برای دولوپری که بعداً استخدام می‌شود. مثل OWNER مخفی است، ولی عمداً
  /// هنوز هیچ دسترسی‌ای ندارد: دامنه‌اش وقتی تعیین می‌شود که واقعاً کسی
  /// بیاید. اینجا تعریف شده تا آن روز مهاجرت دوباره لازم نباشد.
  DEVELOPER
  SUPER_ADMIN // مدیر کل — دسترسی کامل به کار روزمره
  SUPPORT // پشتیبانی — فقط تیکت و گزارش تخلف
  FINANCE // مالی — فقط اشتراک و پرداخت‌ها
  AGENT // نماینده و زیرنماینده
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

/// منبع ایجاد اشتراک: توسط ادمین یا توسط نماینده مادر (حالت ماژول)
enum SubscriptionOrigin {
  ADMIN
  PARENT_SEAT
}

/// نوع حواله: عرضه (فروش) یا درخواست خرید
/// بازارهای سامانه. هر کدام یک ماژول مستقل است؛ اضافه‌شدن یکی، بقیه را
/// دست‌نخورده می‌گذارد.
enum ListingMarket {
  HAVALE // حواله خودرو
  REGISTRATION // ثبت‌نامی
  CAR // خودروی آماده — صفر یا کارکرده
}

/// خلاصه‌ی وضعیت بدنه، مشتق‌شده از جدول قطعه‌به‌قطعه — روی کارت و در فیلتر جستجو
enum CarBodyGrade {
  NO_PAINT // بدون رنگ
  MINOR_PAINT // رنگ جزئی
  PAINTED // رنگ‌شده
  REPLACED // تعویض‌دار
  CHASSIS_DAMAGED // شاسی‌خورده
}

/// در «درخواست خودرو»: خریدار تا چه وضعیت بدنه‌ای را قبول می‌کند
enum CarPaintTolerance {
  NO_PAINT_ONLY // فقط بدون رنگ
  MINOR_OK // تا رنگ جزئی
  ANY // فرقی نمی‌کند
}

// The body shape of a catalogue model — decided by the platform, not the seller.
enum BodyType {
  SEDAN // سدان
  HATCHBACK // هاچبک
  SUV // شاسی‌بلند و کراس‌اوور
  PICKUP // وانت و دوکابین
}

enum HavaleKind {
  OFFER
  REQUEST
}

enum HavaleStatus {
  ACTIVE
  FULFILLED // «فروخته شد» — از لیست عمومی خارج، در پنل مدیریت می‌ماند
  EXPIRED // عمر آگهی تمام شد (برابر «مدت زمان واریز»)
  SUSPENDED
  ARCHIVED
}

/// نوع واگذاری حواله — دو حالت بیشتر ندارد
enum SolhStatus {
  SOLH // صلح
  VEKALATI // وکالتی
}

/// نحوه‌ی پرداختِ خودِ خودرو — نه پرداخت حواله
enum PaymentType {
  CASH // نقد
  STAGED // چند مرحله‌ای
  INSTALLMENT // اقساط
}

enum ReportReason {
  FAKE_LISTING
  WRONG_PRICE
  UNREACHABLE
  ALREADY_SOLD
  FRAUD
  OTHER
}

enum ReportStatus {
  PENDING
  CONFIRMED
  REJECTED
  ABUSIVE
}

enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

/// موضوع گفتگو — برای دسته‌بندی صف پشتیبانی و مسیر درست پاسخ
enum TicketCategory {
  SUBSCRIPTION
  SEATS
  LISTING
  APPEAL
  TECHNICAL
  OTHER
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
}

enum SeatOrderStatus {
  PENDING
  PAID
  REJECTED
}

enum SessionEndReason {
  LOGOUT
  KICKED
  EXPIRED
  ADMIN_REVOKED
}

model User {
  id           String @id @default(cuid())
  username     String @unique
  passwordHash String

  /// رمزنگاری‌شده در پایگاه داده (AES-256-GCM). دامپ لو رفته بدون کلیدِ داخل
  /// .env قابل خواندن نیست. جست‌وجو روی phoneIndex انجام می‌شود، نه این ستون —
  /// چون هر بار نوشتن، متن رمز متفاوتی تولید می‌کند.
  phone      String
  /// HMAC کلیددار همان شماره: تنها راه یکتایی و جست‌وجو روی ستون رمزنگاری‌شده.
  phoneIndex String?    @unique
  fullName   String
  role       Role       @default(AGENT)
  status     UserStatus @default(ACTIVE)

  // ---- پروفایل نمایندگی ----
  // برای هر نماینده الزامی است. کد زیرنماینده خودکار از کد مادر ساخته می‌شود.
  // این فیلدها «قفل‌شده»‌اند: تغییرشان فقط با تیکت و تأیید ادمین ممکن است و
  // با تغییر، همه‌ی آگهی‌های همان نماینده به‌روز می‌شوند.
  agencyCode       String? @unique
  agencyName       String?
  city             String?
  coordinatorName  String?
  /// رمزنگاری‌شده. هرگز جست‌وجو نمی‌شود، پس ایندکس کور لازم ندارد.
  coordinatorPhone String?

  // ---- امنیت ----
  mustChangePassword Boolean @default(true) // اولین ورود: تغییر اجباری پسورد

  /// دسترسی‌های اختصاصی این حساب، اگر با پیش‌فرضِ نقشش فرق داشته باشد.
  ///
  /// null یعنی «هرچه نقش می‌گوید» — که حالت اکثر حساب‌هاست و باعث می‌شود
  /// تغییر سیاست یک نقش، همه‌ی دارندگانش را با هم به‌روز کند. اگر پر باشد،
  /// فقط کلیدهای داخلش نقش را بازنویسی می‌کنند؛ بقیه همچنان از نقش می‌آیند.
  /// مثال: { "export": false } یعنی این مدیر کل، فقط خروجی گرفتن را ندارد.
  permissions Json?

  // ---- سقف نمایش مشخصات ----
  // اگر پر باشند، سقف پلن را برای همین حساب بازنویسی می‌کنند
  dailyRevealLimitOverride   Int?
  monthlyRevealLimitOverride Int?

  // ---- حالت ماژول / زیرنمایندگی ----
  // حساب هرگز حذف نمی‌شود؛ فقط status به SUSPENDED می‌رود.
  // کد نمایندگی زیرنماینده خودکار از کد مادر ساخته می‌شود: G-1024-07
  isReseller  Boolean @default(false)
  // سقف زیرنماینده‌های مجاز. صورتحساب ماهانه‌ی مادر بر اساس تعداد
  // زیرنماینده‌ی فعال محاسبه می‌شود، نه این عدد.
  seatCredits Int     @default(0)
  parentId    String?
  parent      User?   @relation("AgentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    User[]  @relation("AgentHierarchy")

  // ---- سلامت رفتاری ----
  // زمان تعلیق. برای محاسبه‌ی ظرفیت لازم است: تعلیق وسط دوره ظرفیت را آزاد
  // نمی‌کند (بند ۴.۸)، پس باید بدانیم تعلیق در کدام دوره اتفاق افتاده.
  suspendedAt DateTime?

  fakeStrikes        Int     @default(0)
  falseReportStrikes Int     @default(0)
  adminNote          String?

  // آخرین باری که صندوق اطلاعیه‌ها را باز کرده. اطلاعیه‌ها جدولِ خودشان را
  // ندارند — از همان گزارش‌های تخلف ساخته می‌شوند — پس «خوانده‌نشده» یعنی
  // اطلاعیه‌ای که تاریخش از این تازه‌تر است. یک ستون به‌جای یک جدول.
  noticesSeenAt DateTime?

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  subscriptions       Subscription[]    @relation("SubscriptionOwner")
  grantedSubscription Subscription[]    @relation("SubscriptionCreator")
  listings            Listing[]
  sessions            AuthSession[]
  otpChallenges       OtpChallenge[]
  reveals             ContactReveal[]
  reportsFiled        ViolationReport[] @relation("ReportReporter")
  reportsReviewed     ViolationReport[] @relation("ReportReviewer")
  tickets             Ticket[]
  ticketMessages      TicketMessage[]
  seatOrders          SeatOrder[]       @relation("SeatOrderBuyer")
  seatOrdersReviewed  SeatOrder[]       @relation("SeatOrderReviewer")
  activityLogs        ActivityLog[]
  errors              ErrorLog[]        @relation("UserErrors")
  securityEvents      SecurityEvent[]   @relation("UserSecurityEvents")
  smsMessages         SmsMessage[]
  brandAccess         BrandAccess[]
  modelAccess         ModelAccess[]

  @@index([role, status])
  @@index([parentId])
}

/// اجازه‌ی ثبت آگهی روی یک برند.
///
/// همیشه برند، هیچ‌وقت شرکت — و این تصمیم عمدی است. تیک زدن شرکت در پنل
/// میان‌بُر است و همان لحظه به برندهایش باز می‌شود؛ چیزی که ذخیره می‌شود
/// فهرست برندهاست.
///
/// دلیلش این است که دسته‌بندی شرکت‌ها قطعاً جاهایی اشتباه یا ناقص خواهد بود.
/// اگر مجوز روی شرکت ذخیره می‌شد، تصحیحِ یک دسته‌بندی — جابه‌جا کردن یک برند
/// از شرکتی به شرکت دیگر — بی‌صدا دسترسی چند نمایندگی را عوض می‌کرد، و کسی
/// ربطش را نمی‌فهمید. این‌طوری اصلاح دسته‌بندی هیچ‌وقت به مجوزها دست نمی‌زند.
///
/// نبودِ ردیف یعنی «هیچ». پیش‌فرض عمداً بسته است: حسابی که کسی یادش برود
/// تنظیمش کند نباید به همه‌چیز دسترسی داشته باشد.
///
/// فقط جلوی *ثبت* را می‌گیرد. دیدن و استعلام و ثبت درخواست خرید برای همه باز
/// است — این محدودیت تقسیم کار است، نه پنهان‌کاری.
model BrandAccess {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  brandId String
  brand   CarBrand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, brandId])
  @@index([userId])
}

/// اجازه‌ی ثبت آگهی روی «یک مدل مشخص»، وقتی کل برندش داده نشده.
///
/// مکمل BrandAccess است، نه جایگزینش: ردیف برند یعنی «همه‌ی مدل‌های این برند،
/// حالا و در آینده»، و ردیف مدل یعنی «فقط همین یکی». حسابی که کل برند را دارد
/// ردیف مدل لازم ندارد و ذخیره هم نمی‌شود — همان قاعده‌ی «فقط تفاوت‌ها» که
/// دسترسی ادمین‌ها دارد: سیاست برند عوض شود، دارنده‌هایش با هم عوض می‌شوند.
model ModelAccess {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  carModelId String
  carModel   CarModel @relation(fields: [carModelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, carModelId])
  @@index([userId])
}

model Plan {
  id                 String  @id @default(cuid())
  name               String  @unique
  durationDays       Int
  priceToman         BigInt
  dailyRevealLimit   Int     @default(30)
  monthlyRevealLimit Int     @default(300)
  maxActiveHavale    Int     @default(0) // ۰ یعنی بدون سقف
  isActive           Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("SubscriptionOwner", fields: [userId], references: [id], onDelete: Cascade)

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  startsAt   DateTime           @default(now())
  // برای اشتراک‌های PARENT_SEAT این تاریخ مرجع نیست؛ انقضای مؤثر همیشه
  // از اشتراک فعال نماینده‌ی مادر خوانده می‌شود تا تمدید مادر آنی اعمال شود.
  expiresAt  DateTime
  status     SubscriptionStatus @default(ACTIVE)
  priceToman BigInt             @default(0)
  origin     SubscriptionOrigin @default(ADMIN)

  createdById String?
  createdBy   User?   @relation("SubscriptionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status, expiresAt])
}

/// یک آگهی، در هر کدام از بازارها.
///
/// جدول مشترک است چون هر آگهی — از هر بازاری — همین چیزها را دارد: صاحبش،
/// خودرویش، وضعیتش، مهلتش، و شمارنده‌ی بازدید و تخلفش. نمایش مشخصات، سقف
/// روزانه، گزارش تخلف و پنل مدیریت به همین جدول وصل‌اند، پس با اضافه‌شدن هر
/// بازار تازه، همه‌ی آن‌ها روز اول کار می‌کنند.
///
/// جزئیات هر بازار در جدول خودش می‌نشیند (مثل RegistrationDetail)، تا تغییر در
/// یک بازار به بازار دیگر دست نزند. ستون‌های مخصوص حواله پایین‌تر هنوز این‌جا
/// هستند — از قبل از این تقسیم‌بندی — و چون هیچ بازار دیگری آن‌ها را نمی‌خواند،
/// جابه‌جا کردنشان کار امروز نیست.
model Listing {
  id     String @id @default(cuid())
  serial Int    @unique @default(autoincrement())

  /// کدام بازار. هر پرس‌وجوی یک بازار روی همین ستون فیلتر می‌شود.
  market ListingMarket @default(HAVALE)
  kind   HavaleKind

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // الزامی در هر دو نوع.
  // carModelId مرجع کاتالوگ است و فیلتر روی آن انجام می‌شود؛ carType اسنپ‌شات
  // نام همان لحظه است تا تغییر نام مدل، حواله‌های قدیمی را بازنویسی نکند.
  carModelId String?
  carModel   CarModel?   @relation(fields: [carModelId], references: [id], onDelete: SetNull)
  carType    String
  /// فقط در بازار حواله معنا دارد — نوع واگذاری سند.
  solh       SolhStatus?

  // در «حواله فروش» الزامی، در «درخواست خرید» اختیاری
  carColor        String?
  model           String?
  amountToman     BigInt? // مبلغ حواله
  paidAmountToman BigInt? // مبلغ واریز شده تا امروز به شرکت خودروساز
  deliveryDays    Int? // زمان تحویل، به روز
  depositDays     Int? // مدت زمان واریز: مهلت خریدار، به روز
  supplierCompany String?

  /// قیمت خودِ خودرو — جدا از مبلغ حواله. مبلغ حواله بهای واگذاری سند است،
  /// این عدد بهای خودرو. در «حواله فروش» الزامی، در «درخواست خرید» اختیاری.
  carPriceToman BigInt?

  /// نحوه‌ی پرداخت خودرو: نقد، چند مرحله‌ای یا اقساط.
  /// در «حواله فروش» الزامی، در «درخواست خرید» اختیاری.
  paymentType PaymentType?

  // اطلاعات تماس روی حواله ذخیره نمی‌شود؛ همیشه از پروفایل مالک خوانده می‌شود
  // تا با تغییر پروفایل، همه‌ی آگهی‌ها یکجا به‌روز شوند.

  description String?
  status      HavaleStatus @default(ACTIVE)

  suspendReason String?
  // حذف نرم: از دید نماینده‌ها ناپدید می‌شود ولی سابقه‌ی بازدید و
  // گزارش‌های تخلف مربوط به آن در پنل مدیریت باقی می‌ماند.
  deletedAt     DateTime?

  // شمارنده‌ی بازدید — صاحب آگهی فقط همین عدد را می‌بیند، نه هویت بازدیدکننده‌ها
  revealCount Int @default(0)
  reportCount Int @default(0)

  // عمر آگهی: در حواله فروش برابر «مدت زمان واریز»، در درخواست خرید ۷ روز.
  // قابل تمدید یک‌کلیکی.
  closesAt   DateTime?
  renewedAt  DateTime?
  renewCount Int       @default(0)

  // ویرایش، آشکار. `updatedAt` با هر نوشتنی عوض می‌شود — تمدید، فروخته‌شدن،
  // شمارنده‌ی بازدید — پس نمی‌شود گفت «این آگهی ویرایش شده است». اینها فقط
  // با ویرایشِ صاحب آگهی جابه‌جا می‌شوند، و همان چیزی هستند که روی کارت
  // نشان داده می‌شود و کسی که مشخصات را دیده از رویشان خبردار می‌شود.
  editedAt  DateTime?
  editCount Int       @default(0)

  // کِی تعلیق شد. `suspendReason` از قبل بود ولی بدون تاریخ، و بدون تاریخ
  // نمی‌شد در صندوق اطلاعیه‌ی نمایندگی نشانش داد — یعنی متنی که مدیر نوشته
  // بود «نماینده همین را می‌بیند»، هیچ‌جا دیده نمی‌شد.
  suspendedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reveals ContactReveal[]
  reports ViolationReport[]

  /// جزئیات بازار ثبت‌نامی. برای آگهی حواله خالی است و برعکس.
  registration RegistrationDetail?
  /// جزئیات بازار خودرو، به همان قاعده.
  car          CarDetail?
  carPhotos    CarPhoto[]

  @@index([market, status, createdAt])
  @@index([status, closesAt])
  @@index([deletedAt])
  @@index([kind, status, createdAt])
  @@index([ownerId, kind, status])
  @@index([carModelId, status])
  @@index([carType, carColor])
  @@index([supplierCompany])
}

/// روش تخصیص ظرفیت در طرح کارخانه
enum RegistrationMethod {
  LOTTERY // قرعه‌کشی — اسامی قرعه‌کشی می‌شود
  TIME_PRIORITY // اولویت زمانی — هر کس زودتر ثبت کند
}

/// نوع فروش در طرح
enum RegistrationSaleType {
  PRESALE // پیش‌فروش
  CASH_SINGLE // نقدی تک‌مرحله‌ای
  CASH_STAGED // نقدی چند مرحله‌ای
  INSTALLMENT // اقساط
  PRODUCTION_PARTNERSHIP // مشارکت در تولید
}

/// جزئیات یک آگهی در بازار ثبت‌نامی.
///
/// جدا از Listing است تا هر تغییری در این بازار — فیلد تازه، قاعده‌ی تازه —
/// به حواله و بازارهای بعدی دست نزند. آگهی درخواست ثبت‌نام همین جدول را با
/// فیلدهای کمتری پر می‌کند؛ چه چیزی الزامی است، در اعتبارسنجی همان ماژول
/// نوشته شده نه این‌جا.
model RegistrationDetail {
  listingId String  @id
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  /// نام طرح کارخانه، همان‌طور که در آگهی نوشته می‌شود
  planName String?
  method   RegistrationMethod?
  saleType RegistrationSaleType?

  /// چند ظرفیت. سامانه آن را نمی‌شمارد و رزرو نمی‌کند — عددی است که در آگهی
  /// نوشته می‌شود و توافق بیرون از سامانه انجام می‌شود.
  capacity Int?

  /// پولی که ثبت‌نام‌کننده به کارخانه واریز می‌کند
  depositToman BigInt?
  /// پولی که بابت واگذاری این ظرفیت گرفته می‌شود
  premiumToman BigInt?

  /// مهلت ثبت‌نام در طرح. عمر آگهی از روی همین تعیین می‌شود.
  registerDeadline DateTime?
  /// موعد تحویل، همان‌طور که در طرح آمده — متن است چون گاهی «اسفند ۱۴۰۵» است
  deliveryEstimate String?
  /// شرایط ثبت‌نام‌کننده، به زبان خود آگهی‌دهنده
  conditions       String?

  @@index([method, saleType])
}

/// جزئیات بازار خودرو — یک ردیف برای هر آگهی این بازار
model CarDetail {
  listingId String  @id
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  /// نوع بدنه، اسنپ‌شات از کاتالوگ در لحظه‌ی ثبت — مثل carType. آگهی هفت روز
  /// عمر دارد؛ اگر مدل از کاتالوگ حذف شود نقشه‌ی بدنه نباید بشکند.
  bodyType BodyType

  /// سال ساخت شمسی، ۴ رقم. در فروش الزامی است.
  year Int?
  /// در درخواست، بازه‌ی قابل قبول
  yearFrom Int?
  yearTo   Int?

  /// کارکرد به کیلومتر. صفر یعنی صفرکیلومتر. در فروش الزامی است.
  mileageKm    Int?
  /// در درخواست: حداکثر کارکرد قابل قبول
  maxMileageKm Int?

  /// گارانتی فعال دارد؟ در فروش الزامی است؛ در درخواست null.
  warranty Boolean?

  /// کف قیمت در درخواست («قیمت از»)؛ سقفش در Listing.carPriceToman می‌نشیند
  priceFromToman BigInt?

  /// وضعیت قطعه‌به‌قطعه‌ی بدنه: { کلید قطعه: وضعیت }. فقط قطعه‌های مشکل‌دار
  /// ثبت می‌شوند — نبودن کلید یعنی سالم. کلیدها و وضعیت‌های مجاز در
  /// car.constants.js تعریف و در سرویس اعتبارسنجی می‌شوند.
  bodyStatus Json?

  /// خلاصه‌ی مشتق‌شده از bodyStatus — همیشه توسط سرویس محاسبه می‌شود، هرگز از
  /// ورودی نمی‌آید، پس نمی‌تواند با جدولش تناقض داشته باشد.
  bodyGrade CarBodyGrade @default(NO_PAINT)

  /// در درخواست: چه وضعیتی قابل قبول است
  paintTolerance CarPaintTolerance?

  @@index([bodyType, bodyGrade])
}

/// عکس‌های آگهی خودرو. خودِ فایل روی دیسک است؛ این ردیف نام تصادفی و مالکیتش.
/// عکس مثل متنِ آزاد پشت «نمایش مشخصات» است — روی شیشه می‌شود شماره نوشت.
model CarPhoto {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  /// نام فایل روی دیسک — تصادفی، تا نشود حدسش زد؛ سرو شدنش هم پشت مجوز است
  fileName  String @unique
  mime      String
  size      Int
  sortOrder Int    @default(0)

  createdAt DateTime @default(now())

  @@index([listingId])
}

/// هر بار که یک نماینده «مشخصات فروشنده» یک حواله را باز می‌کند اینجا ثبت می‌شود
model ContactReveal {
  id String @id @default(cuid())

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  viewerId String
  viewer   User   @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  ip              String?
  // شماره و کدی که *همان لحظه* نشان داده شد. چون اطلاعات تماس با تأیید
  // ادمین قابل تغییر است، بدون این دو فیلد مدرکی از آنچه واقعاً دیده شده نمی‌ماند.
  phoneShown      String?
  agencyCodeShown String?
  createdAt       DateTime @default(now())

  @@unique([listingId, viewerId])
  @@index([viewerId, createdAt])
  @@index([listingId, createdAt])
}

model ViolationReport {
  id     String @id @default(cuid())
  serial Int    @unique @default(autoincrement())

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  reporterId String
  reporter   User   @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  // گزارش تا ۳۰ روز پس از بسته شدن آگهی هم پذیرفته می‌شود
  reason      ReportReason
  description String
  status      ReportStatus @default(PENDING)

  adminNote          String?
  // زمان اطلاع‌رسانی به آگهی‌دهنده پس از تأیید تخلف، تا فرصت پاسخ از راه تیکت داشته باشد
  ownerNotifiedAt    DateTime?
  // اخطار سوم حساب را تعلیق می‌کند و پشتیبانی حق تعلیق ندارد؛ پس در صف تأیید
  // مدیر کل می‌نشیند (بازبینی سوم، اصلاح ۴).
  needsSuperApproval Boolean   @default(false)

  reviewedById String?
  reviewedBy   User?     @relation("ReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?

  createdAt DateTime @default(now())

  @@unique([listingId, reporterId])
  @@index([status, createdAt])
  @@index([needsSuperApproval, createdAt])
  @@index([reporterId, createdAt])
}

model Ticket {
  id     String @id @default(cuid())
  serial Int    @unique @default(autoincrement())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subject  String
  category TicketCategory @default(OTHER)
  priority TicketPriority @default(NORMAL)
  status   TicketStatus   @default(OPEN)

  lastReplyAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages TicketMessage[]

  @@index([status, lastReplyAt])
  @@index([category, status])
  @@index([userId, createdAt])
}

model TicketMessage {
  id String @id @default(cuid())

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  body      String
  isStaff   Boolean  @default(false)
  createdAt DateTime @default(now())

  attachments TicketAttachment[]

  @@index([ticketId, createdAt])
}

/// پیوست پیام تیکت — عکس یا PDF. فایل روی دیسک با نام تصادفی است و
/// storedAs همان نام است؛ name فقط برای نمایش، هرگز برای مسیر.
model TicketAttachment {
  id String @id @default(cuid())

  messageId String
  message   TicketMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  name     String
  mime     String
  size     Int
  storedAs String @unique

  createdAt DateTime @default(now())

  @@index([messageId])
}

/// نشست فعال — هر حساب فقط یک نشست زنده دارد
model AuthSession {
  id        String @id @default(cuid())
  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  ip        String?
  userAgent String?

  createdAt  DateTime          @default(now())
  lastSeenAt DateTime          @default(now())
  expiresAt  DateTime
  endedAt    DateTime?
  endReason  SessionEndReason?

  @@index([userId, endedAt])
}

/// کد دو عاملی پیامکی
model OtpChallenge {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
}

/// درخواست خرید ظرفیت زیرنمایندگی (حالت ماژول)
model SeatOrder {
  id     String @id @default(cuid())
  serial Int    @unique @default(autoincrement())

  buyerId String
  buyer   User   @relation("SeatOrderBuyer", fields: [buyerId], references: [id], onDelete: Cascade)

  seats          Int
  unitPriceToman BigInt
  totalToman     BigInt
  status         SeatOrderStatus @default(PENDING)

  buyerNote String?
  adminNote String?

  /// فیش واریزی — بدون آن درخواست ثبت نمی‌شود. فایل با نام تصادفی روی دیسک
  /// ذخیره می‌شود؛ receiptName فقط برای نمایش است، هرگز برای ساخت مسیر.
  receiptName     String?
  receiptMime     String?
  receiptSize     Int?
  receiptStoredAs String?
  // زمان اطلاع‌رسانی به آگهی‌دهنده پس از تأیید تخلف، تا فرصت پاسخ از راه تیکت داشته باشد
  ownerNotifiedAt DateTime?
  reviewedById    String?
  reviewedBy      User?     @relation("SeatOrderReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  /// خریدار نتیجه‌ی بررسی را دیده و اعلانش را بسته است
  acknowledgedAt  DateTime?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([buyerId, createdAt])
}

/// گزارش فعالیت برای مانیتورینگ در پنل مدیریت
model ActivityLog {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action     String
  targetType String?
  targetId   String?
  summary    String?
  ip         String?

  /// دستگاه، خلاصه‌شده: «موبایل · Chrome». هدر خام یک پاراگراف تاریخچه‌ی
  /// مرورگرهاست و سؤالی که بعداً پرسیده می‌شود «همان دستگاه بود؟» است.
  device String?

  /// در ویرایش، فقط فیلدهایی که واقعاً عوض شده‌اند: [{field, from, to}].
  ///
  /// چرا لازم است: قبل از این، ویرایش فقط «آگهی را ویرایش کرد» ثبت می‌شد و
  /// اینکه مبلغ از ۵۰ به ۸۰ میلیون رفته هیچ‌جا نبود — و دعواها دقیقاً سر همین
  /// است. چرا فقط تغییرکرده‌ها: ویرایشی که چیزی را عوض نکند هیچ حجمی نمی‌گیرد.
  changes Json?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  /// برای «روی این آگهی چه گذشت» — بدون این، جستجو روی هدف یعنی اسکن کامل.
  @@index([targetId, createdAt])
}

/// خطاهای سامانه، برای بخش «لاگ خطاها» در پنل مدیریت.
///
/// چرا در پایگاه داده و نه فقط در فایل: لاگ فایل روی سرور می‌ماند و برای دیدنش
/// باید SSH بزنی. یک دولوپر باید بتواند از خود پنل ببیند چه شکسته، چند بار
/// تکرار شده، و آخرین بار کِی بوده — بدون دسترسی به سرور.
///
/// خطاهای یکسان با هم جمع می‌شوند (fingerprint) تا یک باگِ پرتکرار، صفحه را
/// پر نکند و بقیه را پنهان نگه ندارد.
model ErrorLog {
  id String @id @default(cuid())

  /// اثر انگشت خطا: پیام + محل وقوع. تکرارهای بعدی همین ردیف را زیاد می‌کنند.
  fingerprint String
  level       String  @default("error")
  message     String
  stack       String?
  path        String?
  method      String?
  statusCode  Int?
  requestId   String?

  /// چه کسی به آن خورده — برای بازتولید. حساب حذف شود، لاگ می‌ماند.
  userId String?
  user   User?   @relation("UserErrors", fields: [userId], references: [id], onDelete: SetNull)

  /// برای ردیف‌های «کند»: بدترین زمانی که تا حالا دیده شده، به میلی‌ثانیه.
  durationMs Int?

  count     Int      @default(1)
  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())

  /// دولوپر بعد از رسیدگی علامت می‌زند تا از فهرست فعال برود.
  resolvedAt DateTime?
  note       String?

  @@unique([fingerprint])
  @@index([lastSeen])
  @@index([resolvedAt, lastSeen])
}

/// تنظیمات قابل ویرایش سامانه (قیمت ظرفیت، سقف گزارش‌ها و ...)
/// رویدادهای امنیتی — تلاش برای نفوذ، اسکن، و حدس رمز.
///
/// چرا جدا از ActivityLog: آن یکی می‌گوید «چه کسی چه کاری کرد» و کاربرانِ
/// شناخته‌شده را ثبت می‌کند. این یکی درباره‌ی کسانی است که کاربر نیستند و
/// شناسه‌شان فقط یک آی‌پی است. یک فهرست مشترک، هر دو را غیرقابل استفاده می‌کرد.
///
/// چرا اثر انگشت: یک اسکنر در چند دقیقه هزاران درخواست می‌زند. اگر هر کدام یک
/// ردیف بود، همان حمله‌ای که باید گزارش شود، جدول را پر می‌کرد — یعنی حمله از
/// طریق سیستمِ گزارشِ حمله. قاعده + آی‌پی یک ردیف است با شمارنده.
model SecurityEvent {
  id String @id @default(cuid())

  /// قاعده + آی‌پی. تکرار، ردیف تازه نمی‌سازد.
  fingerprint String @unique

  /// SQLI, XSS, TRAVERSAL, CMDI, PROTO, SSRF, TEMPLATE, HEADER_INJECT,
  /// PROBE_PATH, SCANNER_UA, BRUTE_FORCE, PASSWORD_SPRAY, RATE_LIMIT,
  /// FORBIDDEN_SWEEP, NOT_FOUND_SWEEP, OVERSIZE
  rule     String
  severity String @default("medium")

  ip        String
  /// نمونه‌ی واقعیِ چیزی که فرستاده شده — بریده، تا خودِ لاگ به مشکل تبدیل نشود.
  sample    String?
  path      String?
  method    String?
  userAgent String?

  /// اگر مهاجم وارد شده بوده. حساب حذف شود، رویداد می‌ماند.
  userId String?
  user   User?   @relation("UserSecurityEvents", fields: [userId], references: [id], onDelete: SetNull)

  count     Int      @default(1)
  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())

  /// مالک بعد از بررسی علامت می‌زند تا از فهرست فعال برود.
  resolvedAt DateTime?
  note       String?

  @@index([lastSeen])
  @@index([rule, lastSeen])
  @@index([ip, lastSeen])
  @@index([resolvedAt, lastSeen])
}

/// آی‌پی‌هایی که دستی بسته شده‌اند.
///
/// هیچ‌وقت خودکار پر نمی‌شود. بستنِ خودکار یعنی یک مهاجم می‌تواند با جعل هدر،
/// آی‌پی نمایندگی‌های واقعی را جای خودش بگذارد و آن‌ها را از سامانه بیرون کند —
/// یعنی ابزار دفاع، خودش سلاح حمله می‌شود.
model BlockedIp {
  ip     String  @id
  reason String?
  /// تا کِی. خالی یعنی بی‌پایان.
  until  DateTime?

  createdById String?
  createdAt   DateTime @default(now())

  @@index([until])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// کاتالوگ خودرو
//
// شرکت عرضه‌کننده، برند و مدل به‌صورت جدول نگه داشته می‌شوند تا از پنل مدیریت
// قابل ویرایش باشند و «فیلتر بر اساس مدل» دقیق کار کند. متن آزاد این را نمی‌دهد:
// «فونیکس FX» و «فونیکس اف ایکس» دو چیز متفاوت می‌شوند و هیچ‌کدام همدیگر را
// پیدا نمی‌کنند.
//
// نام برند و مدل روی خود حواله هم ذخیره می‌شود (اسنپ‌شات)، چون اگر بعداً اسم یک
// مدل عوض شود، حواله‌های قدیمی باید همان چیزی را نشان دهند که موقع ثبت بوده‌اند.
// ─────────────────────────────────────────────────────────────────────────────

/// شرکت خودروساز / واردکننده — مثل «مدیران خودرو»
///
/// فقط برای دسته‌بندی است، نه برای مجوز. هیچ برندی خودکار زیر شرکتی نمی‌رود:
/// تا وقتی کسی در پنل تعیین نکند، برند بدون شرکت می‌ماند. حدس زدن این‌که کدام
/// شرکت کدام برند را عرضه می‌کند، درختی می‌سازد که هر روز جلوی چشم غلط است.
model CarCompany {
  id        String  @id @default(cuid())
  name      String  @unique
  slug      String  @unique
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brands CarBrand[]

  @@index([isActive, sortOrder])
}

/// برند زیرمجموعه — مثل ام‌وی‌ام، فونیکس، اکستریم
model CarBrand {
  /// اختیاری. برندی که شرکتش معلوم نیست زیر «دسته‌بندی‌نشده» می‌ماند و کار
  /// می‌کند — نه حدس زده می‌شود و نه اشتباه جایی گذاشته می‌شود.
  id        String      @id @default(cuid())
  companyId String?
  company   CarCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  name      String
  slug      String  @unique
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  /// نام فایل لوگو در ‎frontend/assets/brands‎ — مثل ‎peugeot.png‎.
  /// نشانی کامل ذخیره نمی‌شود: لوگو روی سرور خودمان می‌نشیند، وگرنه هر بار که
  /// کسی فهرست برندها را باز کند ۱۸۶ درخواست به دامنه‌ی دیگری می‌رود.
  logo String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  models      CarModel[]
  brandAccess BrandAccess[]

  @@unique([companyId, name])
  @@index([isActive, sortOrder])
}

/// مدل خودرو — مثل «فونیکس FX پریمیوم»
model CarModel {
  id      String   @id @default(cuid())
  brandId String
  brand   CarBrand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  // بدون slug: مدل‌ها با شناسه ارجاع داده می‌شوند و اسم فارسی‌شان چیزی برای
  // ساختن slug یکتا نمی‌دهد — «فونیکس FX» و «فونیکس FX پریمیوم» هر دو fx می‌شدند.
  name      String
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  // The body shape, for the خودرو market: it decides which cut-out the body
  // map draws and it is a search filter. It lives on the catalogue — never on
  // the advertisement — because it is a fact about the model, not about the
  // seller's car: a دنا پلاس is a sedan whoever is selling it, and a seller
  // must not be able to say otherwise.
  //
  // Nullable on purpose: null means «nobody has decided yet» and the panel
  // falls back to sedan. The boot-time classifier fills ONLY nulls, so a value
  // an admin set by hand — including an explicit SEDAN — is never overwritten
  // by a rule. A non-null default could not tell those two apart.
  bodyType BodyType?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings    Listing[]
  modelAccess ModelAccess[]

  @@unique([brandId, name])
  @@index([isActive, sortOrder])
}

/// رنگ استاندارد. لیست بسته باعث می‌شود فیلتر رنگ واقعاً کار کند.
model CarColor {
  id        String  @id @default(cuid())
  name      String  @unique
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// ─────────────────────────────────────────────────────────────────────────────
// پیامک
//
// تا وقتی پنل پیامک خریداری نشود، سامانه با کلید خاموش کار می‌کند: پیام‌ها ساخته
// و ذخیره می‌شوند ولی ارسال نمی‌شوند. این‌طور در دمو معلوم است دقیقاً چه چیزی
// قرار بوده برای چه کسی برود، و روزی که پنل فعال شد فقط کلید عوض می‌شود.
// ─────────────────────────────────────────────────────────────────────────────

enum SmsStatus {
  PENDING
  SENT
  FAILED
  SKIPPED // پنل خاموش بوده؛ پیام ساخته شد ولی ارسال نشد
}

model SmsMessage {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  to       String
  template String
  // متن نهایی همان لحظه ذخیره می‌شود؛ اگر بعداً قالب عوض شود، سابقه دست‌نخورده می‌ماند.
  body     String

  status     SmsStatus @default(PENDING)
  driver     String
  providerId String?
  error      String?

  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([status, createdAt])
  @@index([to, createdAt])
  @@index([userId, createdAt])
}
