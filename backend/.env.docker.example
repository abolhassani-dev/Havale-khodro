# Settings for running the whole stack with Docker.
#
#   cp .env.docker.example .env
#   # fill in the two secrets below, then:
#   docker compose up --build
#
# DATABASE_URL is not here on purpose — docker-compose builds it from the
# database credentials, so the app and the database cannot end up disagreeing.

# ---- Application ----
NODE_ENV=production
PORT=3000
API_PREFIX=/api/v1

# ---- Database ----
POSTGRES_USER=havale
POSTGRES_DB=havale
# Required. Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=

# ---- Auth ----
# Required. Generate with: openssl rand -hex 32
SESSION_SECRET=
SESSION_COOKIE_NAME=havale_session
SESSION_TTL_HOURS=12
BCRYPT_ROUNDS=10

# ---- Security ----
# The addresses the frontend is served from. A wildcard here would let any site
# call this API with the user's cookie attached.
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
BODY_LIMIT=1mb

# ---- First run ----
# Applies migrations and creates the first administrator on start. Leave on for
# a staging box; on a real server run the seed once by hand instead.
SEED_ON_START=true
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PHONE=09120000000
# Required when SEED_ON_START is on and NODE_ENV=production.
SEED_ADMIN_PASSWORD=

# Demo agencies and listings, so there is something to click on.
# NEVER set this on a real server: it creates accounts with known passwords.
SEED_DEMO=false

# ---- SMS ----
SMS_ENABLED=false
SMS_DRIVER=log

# ---- Brand ----
# Read from one file (src/constants/brand.js) so a rename is an edit here, not a
# search across the codebase. The internal project name stays `havale`.
BRAND_NAME=FeranoCar
BRAND_NAME_FA=فرانوکار
BRAND_DOMAIN=feranocar.com
BRAND_TAGLINE=سامانه حواله خودرو
BRAND_SUPPORT_EMAIL=support@feranocar.com

# ---- Logging ----
LOG_LEVEL=info
