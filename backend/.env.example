# ---- Application ----
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# ---- Database ----
DATABASE_URL="postgresql://havale:havale@127.0.0.1:5432/havale_dev?schema=public"

# The e2e suite creates and deletes rows, so it uses a database of its own and
# never reads DATABASE_URL. Leave this unset to accept the local default.
# TEST_DATABASE_URL="postgresql://havale:havale@127.0.0.1:5432/havale_test"

# ---- Auth ----
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_COOKIE_NAME=havale_session
SESSION_TTL_HOURS=12
BCRYPT_ROUNDS=10

# ---- Security ----
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
BODY_LIMIT=1mb

# ---- First administrator (npm run seed) ----
# There is no public registration, so the first account is created by the seed
# script. In production SEED_ADMIN_PASSWORD is required; in development a random
# one is generated and printed. The account must change it on first sign-in.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PHONE=09120000000
# SEED_ADMIN_PASSWORD=

# ---- SMS ----
# There is no panel yet, so this stays off. With it off the system still builds
# every message and stores it, it just does not hand it to a provider — so the
# demo shows exactly what would have been sent, and switching on later is a
# setting change rather than a code change.
#
# The stored setting `sms.enabled` overrides this at runtime, so the admin panel
# can turn delivery on without a deploy.
SMS_ENABLED=false
# log = write to the application log instead of sending. kavenegar = real panel.
SMS_DRIVER=log
# Only needed once a real panel is bought. Put these on the server, not in chat.
# SMS_API_KEY=
# SMS_SENDER=

# ---- Brand ----
# Read from one file (src/constants/brand.js) so a rename is an edit here, not a
# search across the codebase. The internal project name stays `havale`.
BRAND_NAME=FeranoCar
BRAND_NAME_FA=فرانوکار
BRAND_DOMAIN=feranocar.com
BRAND_TAGLINE=سامانه حواله خودرو
BRAND_SUPPORT_EMAIL=support@feranocar.com

# ---- Logging ----
LOG_LEVEL=info
