# Production and staging settings for `docker compose up`.
#
#   cp .env.example .env
#   # generate the three secrets below, then:
#   docker compose up -d --build
#
# DATABASE_URL is absent on purpose: compose builds it from the database
# credentials, so the app and the database cannot end up disagreeing.

# ---- Application ----
NODE_ENV=production
PORT=3000
API_PREFIX=/api/v1

# ---- Database ----
POSTGRES_USER=havale
POSTGRES_DB=havale
# Required.  openssl rand -base64 24
POSTGRES_PASSWORD=

# ---- Auth ----
# Required.  openssl rand -hex 32
SESSION_SECRET=
SESSION_COOKIE_NAME=havale_session
SESSION_TTL_HOURS=12
BCRYPT_ROUNDS=10

# ---- Security ----
# nginx serves the frontend and the API from the same origin, so the browser
# never sends an Origin header and CORS does not come into play. Set anyway:
# a wildcard here with credentials enabled would let any site call this API
# with the user's cookie attached.
CORS_ORIGINS=https://feranocar.com,http://45.94.213.252
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
BODY_LIMIT=1mb

# ---- First run ----
# Applies migrations and creates the first administrator on start.
SEED_ON_START=true
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PHONE=09120000000
# Required while SEED_ON_START is on.  openssl rand -base64 18
SEED_ADMIN_PASSWORD=

# Demo agencies and listings, so screens are not empty during review.
# NEVER true once real agencies are on the system: these accounts have a
# password written in the repository.
SEED_DEMO=false
# Under NODE_ENV=production the demo seed refuses to run without this. Set both
# to true only while the machine is a staging box nobody real uses yet — and
# take them out, and suspend the demo agencies, before the first real one
# signs in. If the demo seed declines, the application starts regardless.
ALLOW_DEMO_SEED=false

# ---- SMS ----
# No panel yet. Messages are still rendered and stored, just not delivered.
SMS_ENABLED=false
SMS_DRIVER=log
# SMS_API_KEY=
# SMS_SENDER=

# ---- Brand ----
BRAND_NAME=FeranoCar
BRAND_NAME_FA=فرانوکار
BRAND_DOMAIN=feranocar.com
BRAND_TAGLINE=سامانه حواله خودرو
BRAND_SUPPORT_EMAIL=support@feranocar.com

# ---- Logging ----
LOG_LEVEL=info
