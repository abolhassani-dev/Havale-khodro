# Production and staging settings for `docker compose up`.
#
#   cp .env.example .env
#   # generate the three secrets below, then:
#   docker compose up -d --build
#
# DATABASE_URL is absent on purpose: compose builds it from the database
# credentials, so the app and the database cannot end up disagreeing.

# ---- Application ----
NODE_ENV=production
PORT=3000
API_PREFIX=/api/v1

# ---- Database ----
POSTGRES_USER=havale
POSTGRES_DB=havale
# Required.  openssl rand -base64 24
POSTGRES_PASSWORD=

# ---- Auth ----
# Required.  openssl rand -hex 32
SESSION_SECRET=
SESSION_COOKIE_NAME=havale_session
SESSION_TTL_HOURS=12
BCRYPT_ROUNDS=10

# ---- Security ----
# nginx serves the frontend and the API from the same origin, so the browser
# never sends an Origin header and CORS does not come into play. Set anyway:
# a wildcard here with credentials enabled would let any site call this API
# with the user's cookie attached.
CORS_ORIGINS=https://feranocar.com,http://45.94.213.252
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1200
BODY_LIMIT=1mb

# ---- First run ----
# Applies migrations and creates the first administrator on start.
SEED_ON_START=true
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PHONE=09120000000
# Required while SEED_ON_START is on.  openssl rand -base64 18
SEED_ADMIN_PASSWORD=

# Demo agencies and listings, so screens are not empty during review.
# NEVER true once real agencies are on the system: these accounts have a
# password written in the repository.
SEED_DEMO=false
# Under NODE_ENV=production the demo seed refuses to run without this. Set both
# to true only while the machine is a staging box nobody real uses yet — and
# take them out, and suspend the demo agencies, before the first real one
# signs in. If the demo seed declines, the application starts regardless.
ALLOW_DEMO_SEED=false

# ---- SMS ----
# No panel yet. Messages are still rendered and stored, just not delivered.
SMS_ENABLED=false
SMS_DRIVER=log
# SMS_API_KEY=
# SMS_SENDER=

# ---- Brand ----
BRAND_NAME=FeranoCar
BRAND_NAME_FA=فرانوکار
BRAND_DOMAIN=feranocar.com
BRAND_TAGLINE=سامانه حواله خودرو
BRAND_SUPPORT_EMAIL=support@feranocar.com

# ---- Logging ----
LOG_LEVEL=info

# ---- سقف مصرف حافظه‌ی هر سرویس ----
# بدون سقف، یک نشتی یا کوئری سنگین آن‌قدر رشد می‌کند تا کرنل مجبور شود یکی را
# بکشد — و بزرگ‌ترین را می‌کشد، یعنی Postgres. این همان «دیتابیس بی‌دلیل رفت»
# است. با سقف، همان سرویسِ بدرفتار می‌میرد، با وضعیت روشن، و خودش برمی‌گردد.
#
# مقدارهای زیر برای سروری با ۲ گیگ رم امن‌اند. اگر سرور بزرگ‌تری دارید می‌توانید
# بالاتر ببرید؛ پایین‌تر بردن ریسک دارد.
DB_MEM_LIMIT=1g
API_MEM_LIMIT=640m
WEB_MEM_LIMIT=128m
ADMINER_MEM_LIMIT=128m

# ---- رمزنگاری داده‌های حساس ----
# شماره‌های تماس با این کلید در پایگاه داده رمز می‌شوند. دامپ لو رفته بدون این
# کلید قابل خواندن نیست. تولید: openssl rand -hex 32
# ⚠️ اگر این کلید را گم کنید یا عوض کنید، شماره‌های موجود دیگر خوانده نمی‌شوند.
DATA_ENCRYPTION_KEY=

# ---- ربات هشدار ----
#
# ساده‌ترین راه تنظیم:  ./deploy/alert-setup.sh
# (توکن را همان‌جا روی سرور می‌زنید؛ هیچ‌جا چاپ نمی‌شود.)
#
# مقصد پیام‌ها. تلگرام در ایران فیلتر است و این سرور در ایران است، پس پیش‌فرض
# «بله» است — که همان Bot API تلگرام را دارد، یعنی تمام کد هشدار بدون یک خط
# تغییر با هر دو کار می‌کند.
#   https://tapi.bale.ai        ← بله (پیش‌فرض)
#   https://api.telegram.org    ← تلگرام، اگر روزی مسیری داشتید
ALERT_API_BASE=https://tapi.bale.ai
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- تشدید با پیامک — خاموش ----
#
# پیامک برای این کار گران است، پس خاموش است و پیشنهاد هم نمی‌شود. بله رایگان
# است و همان کار را می‌کند.
#
# این را خالی بگذارید و هیچ پیامکی فرستاده نمی‌شود — حتی یک درخواست هم به
# سمت پنل نمی‌رود. فقط اگر روزی خواستید برای «سیستم خوابیده» زنگ بیدارباش
# داشته باشید، شماره را اینجا بگذارید؛ آن‌وقت حداکثر یک پیامک در شش ساعت
# برای هر مشکل، و فقط برای بحرانی‌ها.
ALERT_SMS_TO=

# ---- تنظیمات پیشرفته (همه پیش‌فرض دارند؛ فقط در صورت نیاز باز کنید) ----
#
# نگه‌داری لاگ‌ها (روز) — کار شبانه (deploy/nightly.sh) آرشیو و پاک می‌کند
# RETAIN_AUTH_DAYS=90
# RETAIN_FAILED_LOGIN_DAYS=30
# RETAIN_LISTING_DAYS=365
# RETAIN_ADMIN_DAYS=730
# RETAIN_RESOLVED_ERROR_DAYS=90
# RETAIN_RESOLVED_SECURITY_DAYS=180
# RETAIN_OTP_DAYS=30
# RETAIN_SMS_DAYS=90
# RETAIN_CAR_PRICE_HISTORY_DAYS=400
# ACTIVITY_ARCHIVE_DIR=/archive
# ACTIVITY_ARCHIVE_DAYS=365
#
# قیمت روز خودرو (deploy/car-prices.sh)
# CAR_PRICES_URL_DOMESTIC=
# CAR_PRICES_URL_IMPORTED=
# CAR_PRICES_TIMEOUT_MS=20000
# CAR_PRICES_USER_AGENT=           # اگر منبع فقط به مرورگر جواب داد
# CAR_PRICES_MIN_ITEMS=20
# CAR_PRICES_STALE_MS=10800000     # ۳ ساعت → برچسب «با تأخیر»
# CAR_PRICES_DROP_MS=604800000     # ۷ روز → ردیف از فهرست می‌افتد
# CAR_PRICES_WATCH_LIMIT=30        # سقف ستاره‌ها
# CAR_PRICES_ALERT_COOLDOWN_MS=10800000
#
# متفرقه
# SLOW_REQUEST_MS=1200             # از این کندتر → لاگ فنی
# UPLOADS_DIR=/app/uploads         # داخل کانتینر؛ volume است
# CLUSTER_WORKERS=1                # چند پروسه‌ی API (سهمیه‌ی rate limit تقسیم می‌شود)
# SESSION_TTL_HOURS=12             # عمر نشست — کوکی و دیتابیس با هم
# BCRYPT_ROUNDS=10
# RATE_LIMIT_MAX=1200              # کف ۶۰۰؛ سقف آدرس ۵ برابر این
