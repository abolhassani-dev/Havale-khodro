# ---- Database ----
DATABASE_URL="postgresql://havale:havale@127.0.0.1:5432/havale_dev?schema=public"

# ---- Security ----
# Random 32+ char secret used to hash session tokens and OTP codes.
AUTH_SECRET="change-me-to-a-long-random-string"

# ---- SMS provider (two-factor codes) ----
# Drivers: console | kavenegar
SMS_DRIVER="console"
SMS_API_KEY=""
SMS_SENDER=""
SMS_TEMPLATE="havale-otp"

# ---- Bootstrap admin (used by `npm run db:seed`) ----
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="Admin@12345"
SEED_ADMIN_PHONE="09120000000"
